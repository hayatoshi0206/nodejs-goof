{
  "name": "goof",
  "version": "1.0.1",
  "description": "A vulnerable todo demo application",
  "homepage": "https://snyk.io/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Snyk/snyk-todo-list-demo-app/"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--openssl-legacy-provider nodemon ./app.js",
    "start": "NODE_OPTIONS=--openssl-legacy-provider node app.js",
    "build": "npx --yes browserify -r jquery > public/js/bundle.js",
    "cleanup": "mongo express-todo --eval 'db.todos.remove({});'",
    "test": "npx --yes snyk test"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "body-parser": "^1.20.3",
    "cfenv": "^1.0.4",
    "consolidate": "0.14.5",
    "dustjs-helpers": "^1.7.4",
    "dustjs-linkedin": "^3.0.1",
    "ejs": "^3.1.10",
    "express-ejs-layouts": "^2.5.1",
    "errorhandler": "^1.5.1",
    "express": "^4.21.2",
    "express-fileupload": "^1.5.1",
    "express-session": "^1.17.2",
    "file-type": "^8.1.0",
    "hbs": "^4.0.4",
    "humanize-ms": "^1.2.1",
    "jquery": "^3.7.1",
    "marked": "^4.3.0",
    "method-override": "^3.0.0",
    "moment": "^2.30.1",
    "mongoose": "^8.24.4",
    "morgan": "^1.10.0",
    "ms": "^2.1.3",
    "mysql": "^2.18.1",
    "optional": "^0.1.3",
    "sanitize-html": "^2.14.0",
    "st": "^3.0.0",
    "typeorm": "^0.3.31",
    "validator": "^13.5.2"
  },
  "overrides": {
    "dustjs-helpers": {
      "dustjs-linkedin": "^3.0.1"
    }
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
